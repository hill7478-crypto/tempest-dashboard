# Copy this file to .env.local for local development.
# On Vercel, set these same two names under Project Settings -> Environment Variables.

# Your Tempest Personal Access Token
# (Tempest web app -> Settings -> Data Authorizations -> Create Token)
TEMPEST_TOKEN=paste_your_token_here

# Your station ID (find it via https://swd.weatherflow.com/swd/rest/stations?token=YOUR_TOKEN
# — look for the "station_id" field in the response)
TEMPEST_STATION_ID=paste_your_station_id_here

# Public (non-secret) — used only to center the radar map on your station.
# Find lat/lon in that same /stations response.
NEXT_PUBLIC_STATION_LAT=31.7619
NEXT_PUBLIC_STATION_LON=-106.4850
NEXT_PUBLIC_STATION_LABEL="My Tempest Station"
